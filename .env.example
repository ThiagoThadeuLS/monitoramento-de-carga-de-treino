# Credenciais do Projeto Supabase
# Copie do painel do Supabase: Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Notificações (Web Push / VAPID): gerar com  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Endereço público da versão web (Vercel). Usado pelos apps iOS/Android em
# links que abrem fora do app (política de privacidade, redefinir senha).
VITE_PUBLIC_APP_URL=https://monitoramento-coral.vercel.app

# OneSignal dos apps iOS/Android (Settings -> Keys & IDs).
# Sem esta chave, os apps das lojas não conseguem pedir permissão de notificação.
VITE_ONESIGNAL_APP_ID=
